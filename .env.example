# Leave empty when the frontend and Pages Functions are served from the same Cloudflare Pages project.
VITE_VIDEOHAT_API_BASE=

# Admin publishing uses a Cloudflare Pages secret, not a frontend env var:
# Pages project -> Settings -> Variables and Secrets -> ADMIN_TOKEN
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
