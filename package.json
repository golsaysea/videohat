{
  "name": "videohat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:dev": "wrangler dev --persist-to .wrangler/state",
    "api:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply videohat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply videohat-db --remote"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "localforage": "^1.10.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
